<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.mcpgateway</groupId>
  <artifactId>mcp-gateway</artifactId>
  <version>1.0.0</version>
  <name>MCP Aggregation Gateway</name>
  <description>轻量 MCP 聚合网关</description>

  <properties>
    <java.version>21</java.version>
    <!-- 需求 13.3：MCP SDK 版本必须固定，不使用动态版本。 -->
    <mcp.sdk.version>2.0.1</mcp.sdk.version>

    <!--
      管理前端（frontend/）。同样按需求 13.3 固定版本：Node 版本写死在这里，
      npm 依赖由 frontend/package-lock.json 锁定，构建走 `npm ci` 而不是 `npm install`。
    -->
    <node.version>v24.15.0</node.version>
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <!--
      跳过前端构建：`mvn -Dfrontend.skip=true verify`。
      只在本地已经手工跑过 `npm run build` 时才用 —— 页面测试依赖
      src/main/resources/static/app/ 下的产物，全新克隆上跳过会让它们失败。
    -->
    <frontend.skip>false</frontend.skip>
    <!--
      单独跳过前端测试。默认跟随 frontend.skip；`-DskipTests` 管不到这里
      （Maven 的 skipTests 只对 surefire 生效），所以镜像构建那种确实不想跑测试的场景
      要显式带上 `-Dfrontend.test.skip=true`。
    -->
    <frontend.test.skip>${frontend.skip}</frontend.test.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-bom</artifactId>
        <version>${mcp.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!--
      需求 14 原本选的是 Thymeleaf 服务端渲染。管理前端迁到 Vue 之后已经没有任何模板，
      依赖随之移除；"单体部署"这一条没有变 —— 前端产物打进同一个 jar，见
      frontend-maven-plugin 那段的说明。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      需求 FR-06.2：打点写入失败时必须写应用错误日志和指标。
      引入 actuator 只为拿到 MeterRegistry；web 端点在 application.yml 里默认只放开 health。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Spring Boot 使用 Jackson 2，因此取 mcp-core + mcp-json-jackson2（需求 14）。 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!--
          生成 META-INF/build-info.properties，让运行期能读到 pom 里的版本号，
          不必再在代码里写死一份（对外上报 MCP clientInfo / serverInfo 要用）。

          这里只加 build-info；父 pom 的 pluginManagement 已经声明了 id 为
          repackage 的执行，execution 按 id 合并，所以打 boot jar 不受影响。

          默认绑在 generate-resources，产物落到 target/classes/，编译和测试
          都能读到。
        -->
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        管理前端的构建。产物落进 src/main/resources/static/app/，随后由
        process-resources 拷进 jar —— 前端和后端仍然是**一个部署单元**。

        为什么不做成独立部署：管理端没有登录、没有会话、没有 CSRF 令牌，
        目前挡住跨站请求的只有"接口只收 application/json"和"没有任何 CORS
        响应头"两点。独立部署必须放开 CORS，那层保护就没了
        （见 SecurityInvariantsTest.noCorsIsEnabled）。开发期同源由 Vite 的
        server.proxy 保证，见 frontend/vite.config.ts。

        三个 execution 都绑在 generate-resources，早于 process-resources，
        所以产物一定赶得上被拷进 target/classes。
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <configuration>
          <workingDirectory>frontend</workingDirectory>
          <!-- Node 装在 target/ 下，`mvn clean` 能清干净，不污染工作区 -->
          <installDirectory>target</installDirectory>
          <skip>${frontend.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <!-- ci 而不是 install：严格按 package-lock.json 装，构建可复现 -->
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <!-- 含 vue-tsc 类型检查，类型不过就让构建失败 -->
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <!--
            前端测试跟 Java 测试跑在同一个 test 阶段。
            需求 15.5 的覆盖率门禁只管 Java 字节码，视图逻辑搬到 Vue 之后
            会掉出那道门禁 —— 这个 execution 就是补上的那道。
          -->
          <execution>
            <id>npm-test</id>
            <phase>test</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run test</arguments>
              <skip>${frontend.test.skip}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- 需求 15.5：总体测试覆盖率不低于 80%，由构建来卡而不是靠人看报告。 -->
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        需求 13.3 / 15.5：把"版本必须固定"和构建环境要求变成硬性检查。
        这些规则跑得很快，放在默认构建里没有代价。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>build-constraints</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>需求 14：本项目要求 Java 21 LTS 及以上。</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireReleaseDeps>
                  <message>需求 13.3：依赖版本必须固定，不允许 SNAPSHOT。</message>
                  <failWhenParentIsSnapshot>true</failWhenParentIsSnapshot>
                </requireReleaseDeps>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      需求 15.5：无已知高危依赖漏洞。
      单独放进 profile 而不是默认构建：这个插件需要下载并更新 NVD 数据库，首次运行很慢，
      离线环境直接失败。让日常构建依赖外部数据源是个坏主意，所以按需运行：

          mvn -Psecurity verify -Dnvd.api.key=<你的 NVD API Key>
    -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>12.1.0</version>
            <configuration>
              <!-- CVSS >= 7 视为高危，直接让构建失败。 -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${nvd.api.key}</nvdApiKey>
              <skipTestScope>true</skipTestScope>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
